{
  "name": "muslim-zone-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@muslim-zone/mobile",
